<div class="bg"></div>

<div class="dream-page">
  <div class="dream-modal show-modal">
    <div class="show-date"><%= @dream.created_at.strftime("%Y/%m/%d") %></div>

    <div class="show-type-badge <%= @dream.dream_type %>">
      <% if @dream.dream_type == "最高" %>
        最高 🌸
      <% elsif @dream.dream_type == "普通" %>
        普通 🌙
      <% else %>
        最悪 😱
      <% end %>
    </div>

    <div class="show-content"><%= @dream.content %></div>

    <% if @dream.bakura_response.present? %>
      <div class="bakura-response-box">
        <div class="bakura-response-name">ばくらより 🌸</div>
        <div class="bakura-response-text"><%= @dream.bakura_response %></div>
      </div>
    <% end %>

    <div class="show-actions">
      <%= link_to "編集する", edit_dream_path(@dream), class: "dream-close-btn" %>
      <%= link_to "ねむねむノートへ", dreams_path, class: "dream-close-btn" %>
      <%= link_to "削除", dream_path(@dream),
      data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
      class: "delete-btn" %>
    </div>
  </div>
</div>