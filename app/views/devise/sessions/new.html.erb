<div class="bg"></div>

<div class="login-page">
  <div class="login-modal">
    <div class="modal-title">夢喰ばくらちゃんと<br>ねむねむノート</div>
    <div class="modal-subtitle">ログイン</div>

    <% if alert %>
      <div class="error-msg show"><%= alert %></div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="input-group">
        <%= f.email_field :email,
            class: "login-input",
            placeholder: "メールアドレス",
            autofocus: true,
            autocomplete: "email" %>
      </div>

      <div class="input-group">
        <%= f.password_field :password,
            class: "login-input",
            placeholder: "パスワード",
            autocomplete: "current-password" %>
      </div>

      <%= f.submit "ログイン", class: "login-btn" %>
    <% end %>

    <div class="modal-links">
      <%= render "devise/shared/links" %>
    </div>
    <div class="static-links">
    <%= link_to "利用規約", terms_path %> ・ <%= link_to "プライバシーポリシー", privacy_path %>
  </div>
  </div>
</div>