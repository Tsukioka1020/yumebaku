<div class="bg"></div>

<div class="home visible" id="homeScreen">
  <!-- 立ち絵エリア -->
  <div class="character-area">
    <div class="character-placeholder">
      <%= image_tag "bakura-01.png", alt: "ばくらちゃん" %>
    </div>

    <!-- セリフウィンドウ -->
    <div class="serif-window">
      <div class="serif-name">ばくらちゃん</div>
      <div class="serif-text" id="serifText">
        だいじょうぶ　だいじょうぶ<br>ばくらちゃんが　怖い夢　ぜ〜んぶ<br>食べちゃったんだからさ！
      </div>
    </div>
  </div>

  <!-- 右エリア -->
  <div class="right-area">
    <div class="clock-circle">
      <div class="clock-time">
        <span id="clockHour">00</span><span class="clock-colon">:</span><span id="clockMin">00</span>
      </div>
    </div>
    <div class="clock-time-mobile">
      <span id="clockHourM">00</span><span class="clock-colon">:</span><span id="clockMinM">00</span>
    </div>

    <%= link_to "ばくらに話す", new_dream_path, class: "main-btn" %>

    <div class="sub-btns">
      <%= link_to dreams_path, class: "sub-btn" do %>
        ねむねむ<br>ノート
       <% end %>
    
      <%= link_to about_path, class: "sub-btn" do %>
      ばくら<br>について
    <% end %>
    </div>
  </div>
  <button class="settings-btn" id="settingsBtn">⚙️</button>
  </div>

  <!-- 初回ログインガイド -->
<% if @show_guide %>
  <div class="guide-overlay visible" id="guideOverlay">
    <div class="guide-modal">
      <div class="guide-img">
        <%= image_tag "bakura-01.png", alt: "ばくらちゃん" %>
      </div>
      <div class="guide-title">はじめまして〜(｡･ω･)ﾉﾞ</div>
      <div class="guide-text">
        わたしは夢を食べる、ばくらちゃんだよ〜。<br><br>
        あなたがみた夢を「ばくらに話す」から聞かせて。<br>
        怖い夢も、嬉しい夢も、<br>
        わたしが全部美味しく食べちゃうから安心してね。<br>
      </div>
      <button class="guide-close-btn" id="guideCloseBtn">はじめる</button>
    </div>
  </div>
<% end %>

<!-- 設定モーダル -->
<div class="settings-overlay" id="settingsOverlay">
  <div class="settings-modal">
    <div class="settings-title">設定</div>

    <%= button_to "ログアウト", destroy_user_session_path,
        method: :delete,
        class: "settings-item-btn btn-1" %>

    <%= button_to "ねむねむノートの履歴を削除",
        destroy_all_dreams_path,
        method: :delete,
        data: { turbo_confirm: "記録を全て削除しますか？" },
        class: "settings-item-btn danger" %>

    <%= button_to "アカウントを削除",
        registration_path(:user),
        method: :delete,
        data: { turbo_confirm: "アカウントを削除しますか？この操作は取り消せません。" },
        class: "settings-item-btn danger" %>

    <button class="settings-close-btn" id="settingsCloseBtn">× 閉じる</button>
  </div>
</div>